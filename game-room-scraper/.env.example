# Copy to .env and fill in. Never commit real credentials.

SCRAPER_BASE_URL=https://example.com
SCRAPER_LOGIN_URL=https://example.com/login
SCRAPER_MACHINE_LIST_URL=https://example.com/machines
SCRAPER_USERNAME=your_username
SCRAPER_PASSWORD=your_password

# headless=true for servers; false while debugging selectors
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000

# SQLite path (relative to project root or absolute)
SCRAPER_DB_PATH=./data/machines.db

# API
API_HOST=127.0.0.1
API_PORT=8090
